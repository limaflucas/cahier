{
  "name": "cahier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cahier, a personal French study notebook",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "NODE_OPTIONS=--no-warnings node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "NODE_OPTIONS=--no-warnings node --env-file-if-exists=.env server/index.js",
    "test": "npm run test:unit",
    "test:unit": "NODE_OPTIONS=--no-warnings node --test test/*.test.js",
    "test:smoke": "NODE_OPTIONS=--no-warnings node --test test/smoke/*.test.js",
    "test:e2e": "npm run build && playwright test",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "unleash-client": "^6.12.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.13"
  }
}
